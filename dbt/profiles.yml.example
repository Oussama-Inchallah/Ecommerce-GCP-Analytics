ecommerce_analytics:
  target: dev
  outputs:
    dev:
      type: bigquery
      method: service-account
      project: "{{ env_var('PROJECT_ID') }}"
      dataset: dbt_dev
      threads: 4
      location: "{{ env_var('REGION', 'US') }}"
      keyfile: "{{ env_var('GOOGLE_APPLICATION_CREDENTIALS') }}"


# Pour Tester localement
      type: postgres
      host: localhost
      port: 5433
      user: gcp
      password: gcp
      dbname: ecommerce_analytics
      schema: dbt_dev