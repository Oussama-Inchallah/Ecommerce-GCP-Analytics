ecommerce_analytics:
  target: "{{ env_var('DBT_TARGET', 'dev') }}"
  outputs:
    gcp:
      type: bigquery
      method: oauth
      project: "{{ env_var('PROJECT_ID') }}"
      dataset: dbt_dev
      threads: 4
      location: "{{ env_var('REGION', 'US') }}"

# localement avec postgres 
    dev:
      type: postgres
      host: localhost
      port: 5433
      user: ecom
      password: ecom
      dbname: ecommerce_warehouse
      schema: dbt_dev
      threads: 4
